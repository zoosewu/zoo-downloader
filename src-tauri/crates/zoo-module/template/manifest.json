{
  "$schema": "./types/manifest.schema.json",
  "apiVersion": 5,
  "id": "example-host",
  "name": "Example Host",
  "version": "0.1.0",
  "description": "Downloads files shared on example.com.",
  "urlPatterns": ["https://example.com/file/*"],
  "permissions": {
    "network": { "allowDomains": ["example.com"] },
    "credentials": [
      { "key": "username", "label": "Username", "secret": false, "optional": true },
      { "key": "password", "label": "Password", "optional": true }
    ]
  }
}
