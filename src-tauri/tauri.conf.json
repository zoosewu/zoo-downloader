{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "zoo-downloader",
  "version": "../package.json",
  "identifier": "com.zoo.zoo-downloader",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:10020",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Zoo Downloader",
        "width": 1600,
        "height": 900,
        "minWidth": 600,
        "minHeight": 400,
        "center": true,
        "closable": true,
        "minimizable": true,
        "maximizable": true,
        "decorations": true,
        "transparent": false,
        "skipTaskbar": false,
        "dragDropEnabled": false,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost https://zoosewu.github.io",
        "img-src": "'self' data: https://zoosewu.github.io",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZEMUNFMEJCOUYwNjdDNjAKUldSZ2ZBYWZ1K0FjYmFPdnpUYTlJUXZVQnpHdklEVXRES3crTEtMbnBqQkhiWW1OTkIvcjlqSngK",
      "endpoints": ["https://github.com/zoosewu/zoo-downloader/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../browser-extension/manifest.json": "browser-extension/manifest.json",
      "../browser-extension/background.js": "browser-extension/background.js",
      "../browser-extension/src/core.js": "browser-extension/src/core.js",
      "../browser-extension/popup.html": "browser-extension/popup.html",
      "../browser-extension/popup.css": "browser-extension/popup.css",
      "../browser-extension/popup.js": "browser-extension/popup.js",
      "../browser-extension/_locales/en/messages.json": "browser-extension/_locales/en/messages.json",
      "../browser-extension/_locales/ja/messages.json": "browser-extension/_locales/ja/messages.json",
      "../browser-extension/_locales/zh_TW/messages.json": "browser-extension/_locales/zh_TW/messages.json",
      "../browser-extension/icons/icon16.png": "browser-extension/icons/icon16.png",
      "../browser-extension/icons/icon32.png": "browser-extension/icons/icon32.png",
      "../browser-extension/icons/icon48.png": "browser-extension/icons/icon48.png",
      "../browser-extension/icons/icon128.png": "browser-extension/icons/icon128.png"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
