{
  "name": "zoo-downloader",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.6.0",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "build:module-host-js": "esbuild src-tauri/crates/zoo-module/js/vendor.js --bundle --format=iife --minify --platform=neutral --main-fields=module,main --target=es2022 --legal-comments=eof --banner:js=\"/* Generated by pnpm build:module-host-js from crates/zoo-module/js/vendor.js. Bundles core-js (MIT) and linkedom (ISC) with their dependencies; licenses in their packages. */\" --outfile=src-tauri/crates/zoo-module/src/gen/vendor.js",
    "dev": "vite --host --mode development",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "tauri": "tauri",
    "tauri:dev": "./scripts/run-tauri-dev.sh",
    "build:win": "tauri build --config src-tauri/tauri.bundle.json --runner cargo-xwin --target x86_64-pc-windows-msvc",
    "build:debug": "tauri build --config src-tauri/tauri.bundle.json --debug --runner cargo-xwin --target x86_64-pc-windows-msvc",
    "build:sidecars": "node scripts/build-sidecars.mjs",
    "package:extension": "node scripts/package-extension.mjs",
    "release": "node scripts/release.mjs",
    "version:check": "node scripts/version.mjs check"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.0.0",
    "@emotion/styled": "^11.0.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "i18next": "^27.1.2",
    "jotai": "^3.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/ui": "^5.1.0",
    "core-js": "^3.51.0",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1",
    "linkedom": "^0.18.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
